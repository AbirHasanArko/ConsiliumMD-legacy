# ──────────────────────────────────────────────
# ConsiliumMD — Backend configuration
# ──────────────────────────────────────────────

# Database
# Dev default uses SQLite. For Docker / Postgres:
# DATABASE_URL=postgresql+psycopg2://consilium:consilium@db:5432/consilium
DATABASE_URL=sqlite:///./consilium.db

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_MIN=1440

# Reasoning provider: "mock" | "carma"
REASONING_PROVIDER=mock

# CARMA (Phase 2)
CARMA_BASE_URL=http://carma:8100
CARMA_API_KEY=
CARMA_TIMEOUT_S=15

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# Seed (dev only)
SEED_DEMO_DATA=true
